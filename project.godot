[application]
config/name="Infinite Ascension"
run/main_scene="res://Main.tscn"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/handheld/orientation=1

[input]
move_forward={"deadzone":0.5,"events":[Object(InputEventKey,"keycode":83),Object(InputEventKey,"keycode":4194320)]}
move_back={"deadzone":0.5,"events":[Object(InputEventKey,"keycode":87),Object(InputEventKey,"keycode":4194322)]}
move_left={"deadzone":0.5,"events":[Object(InputEventKey,"keycode":65),Object(InputEventKey,"keycode":4194319)]}
move_right={"deadzone":0.5,"events":[Object(InputEventKey,"keycode":68),Object(InputEventKey,"keycode":4194321)]}
attack={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":32)]}

[autoload]
SaveManager="*res://scripts/save_manager.gd"
GameLogger="*res://scripts/game_logger.gd"
ActiveAttack="*res://scripts/active_attack.gd"
PauseMenu="*res://scripts/pause_menu.gd"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true

[gui]
theme/default_font_multichannel_signed_distance_field=true
